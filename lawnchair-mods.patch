From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lawnchair Mods <mods@lawnchair>
Date: Mon, 12 May 2026 00:00:00 +0000
Subject: [PATCH] Add mod shortcuts to Lawnchair long-press menu

Registers 6 new SystemShortcut.Factory entries in getSupportedShortcuts():
  Advanced Permissions, Share App, Install to User,
  Show Data Dir, Show App Dir, Select

Fixes:
  - Use ContextThemeWrapper(Theme_DeviceDefault_Light_Dialog_Alert) for all
    AlertDialog.Builder calls so text/background are readable in the
    Launcher's non-AppCompat dark theme.
  - Use PackageManager.MATCH_ALL flag in getInstalledApplications() so the
    app list is never empty on Android 11+ (API 30+).
  - Add MultiUserHelper.getAppsForUser() + SelectShortcut.groupByUser() so
    "Group by User Profile" creates one DrawerFolder per secondary user /
    work profile, named "user <id>", containing all apps for that user.
---

diff --git a/lawnchair/src/app/lawnchair/mods/AdvancedPermissionsHelper.kt b/lawnchair/src/app/lawnchair/mods/AdvancedPermissionsHelper.kt
new file mode 100644
index 0000000..fb85d43
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/mods/AdvancedPermissionsHelper.kt
@@ -0,0 +1,19 @@
+package app.lawnchair.mods
+
+object AdvancedPermissionsHelper {
+
+    suspend fun grantUsageStats(pkg: String) =
+        RootCommandHelper.exec("appops set $pkg PACKAGE_USAGE_STATS allow")
+
+    suspend fun grantAllFiles(pkg: String) =
+        RootCommandHelper.exec("appops set $pkg MANAGE_EXTERNAL_STORAGE allow")
+
+    suspend fun grantUnknownSources(pkg: String) =
+        RootCommandHelper.exec("appops set $pkg REQUEST_INSTALL_PACKAGES allow")
+
+    suspend fun grantAll(pkg: String) = listOf(
+        grantUsageStats(pkg),
+        grantAllFiles(pkg),
+        grantUnknownSources(pkg),
+    )
+}

diff --git a/lawnchair/src/app/lawnchair/mods/ApkShareHelper.kt b/lawnchair/src/app/lawnchair/mods/ApkShareHelper.kt
new file mode 100644
index 0000000..70ac07c
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/mods/ApkShareHelper.kt
@@ -0,0 +1,54 @@
+package app.lawnchair.mods
+
+import android.content.Context
+import android.content.Intent
+import androidx.core.content.FileProvider
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.io.FileInputStream
+import java.io.FileOutputStream
+import java.util.zip.ZipEntry
+import java.util.zip.ZipOutputStream
+
+object ApkShareHelper {
+
+    suspend fun shareApp(context: Context, packageName: String) = withContext(Dispatchers.IO) {
+        val appInfo = context.packageManager.getApplicationInfo(packageName, 0)
+        val splits  = appInfo.splitSourceDirs
+        val file = if (splits.isNullOrEmpty()) {
+            File(appInfo.sourceDir)
+        } else {
+            mergeToApks(context, packageName, appInfo.sourceDir, splits)
+        }
+        val uri  = FileProvider.getUriForFile(context, "${context.packageName}.mods.provider", file)
+        val mime = if (splits.isNullOrEmpty()) "application/vnd.android.package-archive"
+                   else "application/octet-stream"
+        val intent = Intent(Intent.ACTION_SEND).apply {
+            type = mime
+            putExtra(Intent.EXTRA_STREAM, uri)
+            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_ACTIVITY_NEW_TASK)
+        }
+        context.startActivity(
+            Intent.createChooser(intent, "Share APK").addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        )
+    }
+
+    private suspend fun mergeToApks(
+        context: Context,
+        pkg: String,
+        base: String,
+        splits: Array<String>,
+    ): File = withContext(Dispatchers.IO) {
+        val dir = File(context.cacheDir, "mods_apks").also { it.mkdirs() }
+        val out = File(dir, "$pkg.apks")
+        ZipOutputStream(FileOutputStream(out)).use { zip ->
+            for (apk in listOf(File(base)) + splits.map { File(it) }) {
+                zip.putNextEntry(ZipEntry(apk.name))
+                FileInputStream(apk).copyTo(zip)
+                zip.closeEntry()
+            }
+        }
+        out
+    }
+}

diff --git a/lawnchair/src/app/lawnchair/mods/DrawerFolderHelper.kt b/lawnchair/src/app/lawnchair/mods/DrawerFolderHelper.kt
new file mode 100644
index 0000000..0bad932
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/mods/DrawerFolderHelper.kt
@@ -0,0 +1,58 @@
+package app.lawnchair.mods
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+data class DrawerFolder(val id: String, val name: String, val apps: MutableList<String> = mutableListOf())
+
+object DrawerFolderHelper {
+
+    private fun file(context: Context) = File(context.filesDir, "mods_drawer_folders.json")
+
+    suspend fun load(context: Context): List<DrawerFolder> = withContext(Dispatchers.IO) {
+        val f = file(context)
+        if (!f.exists()) return@withContext emptyList()
+        val arr = JSONArray(f.readText())
+        (0 until arr.length()).map { i ->
+            val o = arr.getJSONObject(i)
+            val apps = o.getJSONArray("apps")
+            DrawerFolder(
+                id = o.getString("id"),
+                name = o.getString("name"),
+                apps = (0 until apps.length()).map { apps.getString(it) }.toMutableList(),
+            )
+        }
+    }
+
+    suspend fun save(context: Context, folders: List<DrawerFolder>) = withContext(Dispatchers.IO) {
+        val arr = JSONArray()
+        folders.forEach { folder ->
+            arr.put(JSONObject().apply {
+                put("id", folder.id)
+                put("name", folder.name)
+                put("apps", JSONArray().also { a -> folder.apps.forEach { a.put(it) } })
+            })
+        }
+        file(context).writeText(arr.toString())
+    }
+
+    suspend fun createFolder(context: Context, name: String, apps: List<String>): DrawerFolder {
+        val folders = load(context).toMutableList()
+        val folder  = DrawerFolder("folder_${System.currentTimeMillis()}", name, apps.toMutableList())
+        folders.add(folder)
+        save(context, folders)
+        return folder
+    }
+
+    suspend fun addToFolder(context: Context, folderId: String, apps: List<String>) {
+        val folders = load(context).toMutableList()
+        val i = folders.indexOfFirst { it.id == folderId }
+        if (i < 0) return
+        apps.forEach { pkg -> if (pkg !in folders[i].apps) folders[i].apps.add(pkg) }
+        save(context, folders)
+    }
+}

diff --git a/lawnchair/src/app/lawnchair/mods/MultiUserHelper.kt b/lawnchair/src/app/lawnchair/mods/MultiUserHelper.kt
new file mode 100644
index 0000000..d4f8a21
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/mods/MultiUserHelper.kt
@@ -0,0 +1,28 @@
+package app.lawnchair.mods
+
+import android.content.Context
+import android.os.UserManager
+
+data class UserInfo(val id: Int, val name: String)
+
+object MultiUserHelper {
+
+    fun getSecondaryUsers(context: Context): List<UserInfo> {
+        val um = context.getSystemService(Context.USER_SERVICE) as UserManager
+        return um.userProfiles
+            .filter { it.identifier != 0 }
+            .map { UserInfo(it.identifier, "user ${it.identifier}") }
+    }
+
+    suspend fun installToUser(packageName: String, userId: Int): RootCommandHelper.RootResult =
+        RootCommandHelper.exec("pm install-existing --user $userId $packageName")
+
+    /** Returns all package names installed for [userId] via root shell. */
+    suspend fun getAppsForUser(userId: Int): List<String> {
+        val result = RootCommandHelper.exec("pm list packages --user $userId")
+        if (!result.success) return emptyList()
+        return result.output.lines()
+            .filter { it.startsWith("package:") }
+            .map { it.removePrefix("package:").trim() }
+    }
+}

diff --git a/lawnchair/src/app/lawnchair/mods/RootCommandHelper.kt b/lawnchair/src/app/lawnchair/mods/RootCommandHelper.kt
new file mode 100644
index 0000000..c2d142c
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/mods/RootCommandHelper.kt
@@ -0,0 +1,30 @@
+package app.lawnchair.mods
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.BufferedReader
+import java.io.InputStreamReader
+import java.io.OutputStreamWriter
+
+object RootCommandHelper {
+
+    data class RootResult(val output: String, val error: String, val exitCode: Int) {
+        val success get() = exitCode == 0
+    }
+
+    suspend fun exec(vararg commands: String): RootResult = withContext(Dispatchers.IO) {
+        try {
+            val process = Runtime.getRuntime().exec("su")
+            val writer = OutputStreamWriter(process.outputStream)
+            for (cmd in commands) writer.write("$cmd\n")
+            writer.write("exit\n")
+            writer.flush()
+            writer.close()
+            val output = BufferedReader(InputStreamReader(process.inputStream)).readText().trim()
+            val error  = BufferedReader(InputStreamReader(process.errorStream)).readText().trim()
+            RootResult(output, error, process.waitFor())
+        } catch (e: Exception) {
+            RootResult("", e.message ?: "Unknown error", -1)
+        }
+    }
+}

diff --git a/lawnchair/src/app/lawnchair/mods/RootExplorerHelper.kt b/lawnchair/src/app/lawnchair/mods/RootExplorerHelper.kt
new file mode 100644
index 0000000..9c0788b
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/mods/RootExplorerHelper.kt
@@ -0,0 +1,41 @@
+package app.lawnchair.mods
+
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+
+object RootExplorerHelper {
+
+    private val EXPLORERS = listOf(
+        "com.mixplorer",
+        "com.mixplorer.silver",
+        "bin.mt.plus.canary",
+        "bin.mt.plus",
+    )
+
+    fun openPath(context: Context, path: String) {
+        val explorer = findExplorer(context)
+            ?: throw IllegalStateException("No supported root explorer installed (MiXplorer / MT Manager)")
+        val intent = Intent(Intent.ACTION_VIEW).apply {
+            setPackage(explorer)
+            data = Uri.parse("file://$path")
+            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        }
+        context.startActivity(intent)
+    }
+
+    fun openDataDir(context: Context, packageName: String) =
+        openPath(context, "/data/data/$packageName")
+
+    fun openAppDir(context: Context, packageName: String) {
+        val apk = context.packageManager.getApplicationInfo(packageName, 0).publicSourceDir
+        openPath(context, apk)
+    }
+
+    fun findExplorer(context: Context): String? =
+        EXPLORERS.firstOrNull {
+            runCatching { context.packageManager.getPackageInfo(it, 0) }.isSuccess
+        }
+
+    fun hasExplorer(context: Context) = findExplorer(context) != null
+}

diff --git a/lawnchair/src/app/lawnchair/ui/popup/ModsShortcuts.kt b/lawnchair/src/app/lawnchair/ui/popup/ModsShortcuts.kt
new file mode 100644
index 0000000..a3f9c12
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/ui/popup/ModsShortcuts.kt
@@ -0,0 +1,284 @@
+package app.lawnchair.ui.popup
+
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.view.ContextThemeWrapper
+import android.view.View
+import android.widget.EditText
+import android.widget.Toast
+import android.app.AlertDialog
+import app.lawnchair.mods.AdvancedPermissionsHelper
+import app.lawnchair.mods.ApkShareHelper
+import app.lawnchair.mods.DrawerFolderHelper
+import app.lawnchair.mods.MultiUserHelper
+import app.lawnchair.mods.RootExplorerHelper
+import app.lawnchair.mods.UserInfo
+import com.android.launcher3.Launcher
+import com.android.launcher3.R
+import com.android.launcher3.model.data.ItemInfo
+import com.android.launcher3.popup.SystemShortcut
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+object ModsShortcuts {
+
+    private val scope = CoroutineScope(Dispatchers.Main + SupervisorJob())
+
+    /**
+     * Wraps [ctx] with Theme_DeviceDefault_Light_Dialog_Alert so every
+     * AlertDialog has a white background with dark text, regardless of
+     * the Launcher activity's own dark/opaque theme.
+     */
+    private fun alertBuilder(ctx: Context) =
+        AlertDialog.Builder(
+            ContextThemeWrapper(ctx, android.R.style.Theme_DeviceDefault_Light_Dialog_Alert)
+        )
+
+    // ─── Advanced Permissions ────────────────────────────────────────────────
+
+    val ADVANCED_PERMISSIONS = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val pkg = itemInfo.targetComponent?.packageName ?: return@Factory null
+        AdvancedPermissionsShortcut(launcher, itemInfo, view, pkg)
+    }
+
+    private class AdvancedPermissionsShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View, private val pkg: String,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_info_no_shadow, R.string.mods_advanced_permissions, launcher, itemInfo, view) {
+
+        override fun onClick(v: View) {
+            alertBuilder(mTarget)
+                .setTitle("Advanced Permissions")
+                .setItems(arrayOf("Grant Usage Stats", "Grant Access All Files", "Grant Unknown Sources", "Grant All")) { _, which ->
+                    scope.launch {
+                        val results = when (which) {
+                            0 -> listOf(AdvancedPermissionsHelper.grantUsageStats(pkg))
+                            1 -> listOf(AdvancedPermissionsHelper.grantAllFiles(pkg))
+                            2 -> listOf(AdvancedPermissionsHelper.grantUnknownSources(pkg))
+                            else -> AdvancedPermissionsHelper.grantAll(pkg)
+                        }
+                        val ok = results.all { it.success }
+                        toast(mTarget, if (ok) "Permissions granted" else "Failed: ${results.firstOrNull { !it.success }?.error}")
+                    }
+                }
+                .show()
+        }
+    }
+
+    // ─── Share App ───────────────────────────────────────────────────────────
+
+    val SHARE_APP = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val pkg = itemInfo.targetComponent?.packageName ?: return@Factory null
+        ShareAppShortcut(launcher, itemInfo, view, pkg)
+    }
+
+    private class ShareAppShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View, private val pkg: String,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_install_no_shadow, R.string.mods_share_app, launcher, itemInfo, view) {
+
+        override fun onClick(v: View) {
+            scope.launch {
+                runCatching { ApkShareHelper.shareApp(mTarget, pkg) }
+                    .onFailure { toast(mTarget, "Share failed: ${it.message}") }
+            }
+        }
+    }
+
+    // ─── Install to Another User ─────────────────────────────────────────────
+
+    val INSTALL_TO_USER = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val pkg   = itemInfo.targetComponent?.packageName ?: return@Factory null
+        val users = MultiUserHelper.getSecondaryUsers(launcher)
+        if (users.isEmpty()) return@Factory null
+        InstallToUserShortcut(launcher, itemInfo, view, pkg, users)
+    }
+
+    private class InstallToUserShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View,
+        private val pkg: String, private val users: List<UserInfo>,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_install_no_shadow, R.string.mods_install_to_user, launcher, itemInfo, view) {
+
+        override fun onClick(v: View) {
+            alertBuilder(mTarget)
+                .setTitle("Install to User")
+                .setItems(users.map { it.name }.toTypedArray()) { _, which ->
+                    val user = users[which]
+                    scope.launch {
+                        val result = MultiUserHelper.installToUser(pkg, user.id)
+                        toast(mTarget, if (result.success) "Installed to ${user.name}" else "Failed: ${result.error}")
+                    }
+                }
+                .show()
+        }
+    }
+
+    // ─── Show Data Dir ───────────────────────────────────────────────────────
+
+    val SHOW_DATA_DIR = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val pkg = itemInfo.targetComponent?.packageName ?: return@Factory null
+        if (!RootExplorerHelper.hasExplorer(launcher)) return@Factory null
+        ShowDataDirShortcut(launcher, itemInfo, view, pkg)
+    }
+
+    private class ShowDataDirShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View, private val pkg: String,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_info_no_shadow, R.string.mods_show_data_dir, launcher, itemInfo, view) {

+        override fun onClick(v: View) {
+            runCatching { RootExplorerHelper.openDataDir(mTarget, pkg) }
+                .onFailure { toast(mTarget, "Error: ${it.message}") }
+        }
+    }
+
+    // ─── Show App Dir ────────────────────────────────────────────────────────
+
+    val SHOW_APP_DIR = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val pkg = itemInfo.targetComponent?.packageName ?: return@Factory null
+        if (!RootExplorerHelper.hasExplorer(launcher)) return@Factory null
+        ShowAppDirShortcut(launcher, itemInfo, view, pkg)
+    }
+
+    private class ShowAppDirShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View, private val pkg: String,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_install_no_shadow, R.string.mods_show_app_dir, launcher, itemInfo, view) {
+
+        override fun onClick(v: View) {
+            runCatching { RootExplorerHelper.openAppDir(mTarget, pkg) }
+                .onFailure { toast(mTarget, "Error: ${it.message}") }
+        }
+    }
+
+    // ─── Select ──────────────────────────────────────────────────────────────
+
+    val SELECT = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val pkg = itemInfo.targetComponent?.packageName ?: return@Factory null
+        SelectShortcut(launcher, itemInfo, view, pkg)
+    }
+
+    private class SelectShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View, private val pkg: String,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_uninstall_no_shadow, R.string.mods_select, launcher, itemInfo, view) {
+
+        override fun onClick(v: View) {
+            val ctx = mTarget
+            val pm  = ctx.packageManager
+            // Fix: MATCH_ALL is required on Android 11+ (API 30) so that
+            // getInstalledApplications() returns all packages instead of
+            // only the caller's own package (which made the list appear empty).
+            @Suppress("DEPRECATION")
+            val allApps = pm.getInstalledApplications(PackageManager.GET_META_DATA or PackageManager.MATCH_ALL)
+                .filter { it.flags and ApplicationInfo.FLAG_SYSTEM == 0 }
+                .sortedBy { pm.getApplicationLabel(it).toString() }
+            val labels  = allApps.map { pm.getApplicationLabel(it).toString() }.toTypedArray()
+            val pkgList = allApps.map { it.packageName }
+            val checked = BooleanArray(allApps.size) { allApps[it].packageName == pkg }
+
+            alertBuilder(ctx)
+                .setTitle("Select Apps")
+                .setMultiChoiceItems(labels, checked) { _, which, isChecked -> checked[which] = isChecked }
+                .setPositiveButton("Next") { _, _ ->
+                    val selected = pkgList.filterIndexed { i, _ -> checked[i] }
+                    if (selected.isNotEmpty()) showActionDialog(ctx, selected)
+                }
+                .setNegativeButton("Cancel", null)
+                .show()
+        }
+
+        private fun showActionDialog(ctx: Context, selected: List<String>) {
+            val count = selected.size
+            alertBuilder(ctx)
+                .setTitle("$count app${if (count == 1) "" else "s"} selected")
+                .setItems(arrayOf("Merge to Folder", "Group by User Profile", "Share", "Uninstall")) { _, which ->
+                    when (which) {
+                        0 -> showMergeDialog(ctx, selected)
+                        1 -> groupByUser(ctx)
+                        2 -> scope.launch {
+                            selected.forEach { p ->
+                                runCatching { ApkShareHelper.shareApp(ctx, p) }
+                                    .onFailure { toast(ctx, "Share failed for $p") }
+                            }
+                        }
+                        3 -> selected.forEach { p ->
+                            ctx.startActivity(Intent(Intent.ACTION_UNINSTALL_PACKAGE).apply {
+                                data = Uri.parse("package:$p")
+                                putExtra(Intent.EXTRA_RETURN_RESULT, true)
+                                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                            })
+                        }
+                    }
+                }
+                .show()
+        }
+
+        /**
+         * Fix: creates one DrawerFolder per secondary user / work-profile.
+         * Each folder is named "user <id>" and is populated with all packages
+         * reported by `pm list packages --user <id>` (requires root).
+         */
+        private fun groupByUser(ctx: Context) {
+            val users = MultiUserHelper.getSecondaryUsers(ctx)
+            if (users.isEmpty()) {
+                toast(ctx, "No secondary users / work profiles found")
+                return
+            }
+            scope.launch {
+                var created = 0
+                users.forEach { user ->
+                    val apps = MultiUserHelper.getAppsForUser(user.id)
+                        .filter { it.isNotBlank() }
+                    if (apps.isNotEmpty()) {
+                        DrawerFolderHelper.createFolder(ctx, user.name, apps)
+                        created++
+                    }
+                }
+                toast(
+                    ctx,
+                    if (created > 0) "Created $created folder(s) for user profiles"
+                    else "No apps found for user profiles (root may be required)"
+                )
+            }
+        }
+
+        private fun showMergeDialog(ctx: Context, selected: List<String>) {
+            scope.launch {
+                val existing = DrawerFolderHelper.load(ctx)
+                val options  = (listOf("+ New folder") + existing.map { it.name }).toTypedArray()
+                withContext(Dispatchers.Main) {
+                    alertBuilder(ctx)
+                        .setTitle("Merge to Folder")
+                        .setItems(options) { _, which ->
+                            if (which == 0) {
+                                showCreateFolderDialog(ctx, selected)
+                            } else {
+                                val folder = existing[which - 1]
+                                scope.launch {
+                                    DrawerFolderHelper.addToFolder(ctx, folder.id, selected)
+                                    toast(ctx, "Added to \"${folder.name}\"")
+                                }
+                            }
+                        }
+                        .show()
+                }
+            }
+        }
+
+        private fun showCreateFolderDialog(ctx: Context, selected: List<String>) {
+            val input = EditText(
+                ContextThemeWrapper(ctx, android.R.style.Theme_DeviceDefault_Light_Dialog_Alert)
+            ).apply { hint = "Folder name" }
+            alertBuilder(ctx)
+                .setTitle("New Folder")
+                .setView(input)
+                .setPositiveButton("Create") { _, _ ->
+                    val name = input.text.toString().trim()
+                    if (name.isEmpty()) { toast(ctx, "Name cannot be empty"); return@setPositiveButton }
+                    scope.launch {
+                        DrawerFolderHelper.createFolder(ctx, name, selected)
+                        toast(ctx, "Folder \"$name\" created")
+                    }
+                }
+                .setNegativeButton("Cancel", null)
+                .show()
+        }
+    }
+
+    private fun toast(ctx: Context, msg: String) =
+        Toast.makeText(ctx, msg, Toast.LENGTH_SHORT).show()
+}

diff --git a/res/values/mods_strings.xml b/res/values/mods_strings.xml
new file mode 100644
index 0000000..2f4e2b6
--- /dev/null
+++ b/res/values/mods_strings.xml
@@ -0,0 +1,9 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <string name="mods_advanced_permissions">Advanced Permissions</string>
+    <string name="mods_share_app">Share App</string>
+    <string name="mods_install_to_user">Install to User</string>
+    <string name="mods_show_data_dir">Show Data Dir</string>
+    <string name="mods_show_app_dir">Show App Dir</string>
