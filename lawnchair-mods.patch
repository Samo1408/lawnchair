From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lawnchair Mods <mods@lawnchair>
Date: Mon, 12 May 2026 00:00:00 +0000
Subject: [PATCH] Add mod shortcuts ported from HomeLauncher

Ports the working implementation from HomeLauncher to Lawnchair's
SystemShortcut.Factory API. Key improvements over the previous patch:

  Advanced Permissions  — now uses Settings intents (no root needed).
  Share App             — split-APK aware, FileProvider-based, async.
  Install to User       — uses `pm list users` (root) to find users.
  Show Data Dir         — no longer hidden when no browser installed;
  Show App Dir            toast shown on tap instead.
  Group by User Profile — uses LauncherApps API (no root needed) so
                          work-profile apps are enumerated correctly.
  Select                — user-profile picker first, then LauncherApps
                          to list apps for that profile (no root needed).

All dialogs use ContextThemeWrapper(Theme_DeviceDefault_Light_Dialog_Alert)
so they show white backgrounds in Lawnchair's dark/transparent theme.

NOTE: Add the following provider to AndroidManifest.xml <application>
      for the Share App feature (APK file sharing):

  <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.mods.provider"
            android:exported="false" android:grantUriPermissions="true">
    <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
               android:resource="@xml/mods_provider_paths"/>
  </provider>
---


diff --git a/lawnchair/src/app/lawnchair/mods/RootUtil.kt b/lawnchair/src/app/lawnchair/mods/RootUtil.kt
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/mods/RootUtil.kt
@@ -0,0 +1,43 @@
+package app.lawnchair.mods
+
+import android.util.Log
+import java.io.BufferedReader
+import java.io.DataOutputStream
+import java.io.InputStreamReader
+
+object RootUtil {
+
+    fun runAsRoot(vararg cmds: String): Boolean = try {
+        val p = Runtime.getRuntime().exec("su")
+        DataOutputStream(p.outputStream).use { os ->
+            cmds.forEach { os.writeBytes(it + "\n") }
+            os.writeBytes("exit\n")
+            os.flush()
+        }
+        p.waitFor() == 0
+    } catch (t: Throwable) {
+        Log.e("RootUtil", "su failed", t); false
+    }
+
+    fun runAsRootCapture(cmd: String): String? = try {
+        val p = Runtime.getRuntime().exec("su")
+        DataOutputStream(p.outputStream).use { os ->
+            os.writeBytes(cmd + "\n")
+            os.writeBytes("exit\n")
+            os.flush()
+        }
+        val out = BufferedReader(InputStreamReader(p.inputStream)).use { it.readText() }
+        if (p.waitFor() == 0) out else null
+    } catch (t: Throwable) {
+        Log.e("RootUtil", "su capture failed", t); null
+    }
+
+    /** Parse `pm list users` output. Lines look like: UserInfo{0:Owner:13} running */
+    fun listUsers(): List<Pair<Int, String>> {
+        val out = runAsRootCapture("pm list users") ?: return emptyList()
+        val re = Regex("""UserInfo\{(\d+):([^:}]*):""")
+        return re.findAll(out).map { m ->
+            m.groupValues[1].toInt() to m.groupValues[2].trim().ifEmpty { "User ${m.groupValues[1]}" }
+        }.toList()
+    }
+}

diff --git a/lawnchair/src/app/lawnchair/mods/IntentUtil.kt b/lawnchair/src/app/lawnchair/mods/IntentUtil.kt
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/mods/IntentUtil.kt
@@ -0,0 +1,189 @@
+package app.lawnchair.mods
+
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.provider.Settings
+import android.view.ContextThemeWrapper
+import android.widget.Toast
+import androidx.core.content.FileProvider
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.io.FileInputStream
+import java.io.FileOutputStream
+import java.util.zip.ZipEntry
+import java.util.zip.ZipOutputStream
+
+/**
+ * Ported from HomeLauncher's IntentUtil.kt.
+ * Handles root browser opening, APK sharing, and advanced permissions.
+ */
+object IntentUtil {
+
+    // Add this provider to your AndroidManifest.xml inside <application>:
+    //
+    //   <provider android:name="androidx.core.content.FileProvider"
+    //             android:authorities="${applicationId}.mods.provider"
+    //             android:exported="false"
+    //             android:grantUriPermissions="true">
+    //     <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
+    //                android:resource="@xml/mods_provider_paths"/>
+    //   </provider>
+
+    private val ROOT_BROWSERS = listOf(
+        "com.mixplorer",
+        "com.mixplorer.silver",
+        "bin.mt.plus.canary",
+        "bin.mt.plus",
+    )
+
+    private fun themed(ctx: Context) =
+        ContextThemeWrapper(ctx, android.R.style.Theme_DeviceDefault_Light_Dialog_Alert)
+
+    // ── Root browser ───────────────────────────────────────────────────────
+
+    private fun installedRootBrowsers(ctx: Context): List<String> =
+        ROOT_BROWSERS.filter {
+            runCatching { ctx.packageManager.getPackageInfo(it, 0); true }.getOrDefault(false)
+        }
+
+    /**
+     * Tries multiple MIME types to open [path] in [browserPkg].
+     * Falls back to launching the browser root + showing path as a toast.
+     * Ported from HomeLauncher's IntentUtil.launchBrowserAt().
+     */
+    private fun launchBrowserAt(ctx: Context, browserPkg: String, path: String): Boolean {
+        try { android.os.StrictMode.setVmPolicy(android.os.StrictMode.VmPolicy.Builder().build()) }
+        catch (_: Throwable) {}
+        val uri = Uri.parse("file://$path")
+        for (mime in listOf("resource/folder", "vnd.android.document/directory", "inode/directory", "*/*", null)) {
+            try {
+                ctx.startActivity(Intent(Intent.ACTION_VIEW).apply {
+                    if (mime == null) data = uri else setDataAndType(uri, mime)
+                    setPackage(browserPkg)
+                    addFlags(Intent.FLAG_ACTIVITY_NEW_TASK or Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_GRANT_WRITE_URI_PERMISSION)
+                }); return true
+            } catch (_: Throwable) {}
+        }
+        return try {
+            val i = ctx.packageManager.getLaunchIntentForPackage(browserPkg) ?: return false
+            ctx.startActivity(i.addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+            Toast.makeText(ctx, path, Toast.LENGTH_LONG).show(); true
+        } catch (_: Throwable) { false }
+    }
+
+    fun openInRootBrowser(ctx: Context, path: String) {
+        val installed = installedRootBrowsers(ctx)
+        if (installed.isEmpty()) {
+            Toast.makeText(ctx, R.string.mods_no_root_browser, Toast.LENGTH_LONG).show(); return
+        }
+        if (installed.size == 1) {
+            if (!launchBrowserAt(ctx, installed[0], path))
+                Toast.makeText(ctx, R.string.mods_no_root_browser, Toast.LENGTH_SHORT).show()
+            return
+        }
+        val pm = ctx.packageManager
+        val labels = installed.map {
+            runCatching { pm.getApplicationInfo(it, 0).loadLabel(pm).toString() }.getOrDefault(it)
+        }.toTypedArray()
+        android.app.AlertDialog.Builder(themed(ctx))
+            .setTitle(R.string.mods_choose_root_browser)
+            .setItems(labels) { _, w -> launchBrowserAt(ctx, installed[w], path) }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+
+    fun openAppDataDir(ctx: Context, pkg: String) =
+        openInRootBrowser(ctx, "/data/data/$pkg")
+
+    fun openAppInstallDir(ctx: Context, pkg: String) {
+        try {
+            val parent = File(ctx.packageManager.getApplicationInfo(pkg, 0).sourceDir).parent ?: "/data/app"
+            openInRootBrowser(ctx, parent)
+        } catch (_: Throwable) { openInRootBrowser(ctx, "/data/app") }
+    }
+
+    // ── APK sharing ────────────────────────────────────────────────────────
+
+    /** Split-APK aware sharing. Runs on IO. Ported from HomeLauncher's shareApp(). */
+    fun shareApp(ctx: Context, pkg: String, label: String) {
+        Toast.makeText(ctx, R.string.mods_share_preparing, Toast.LENGTH_SHORT).show()
+        CoroutineScope(Dispatchers.IO).launch {
+            try {
+                val ai    = ctx.packageManager.getApplicationInfo(pkg, 0)
+                val splits = ai.splitSourceDirs
+                val dir   = File(ctx.cacheDir, "mods_apks").apply { mkdirs() }
+                dir.listFiles()?.forEach { runCatching { it.delete() } }
+                val name  = label.replace(Regex("[^A-Za-z0-9._-]"), "_").ifEmpty { pkg }
+                val (file, mime) = if (splits.isNullOrEmpty()) {
+                    File(dir, "$name.apk").also { File(ai.sourceDir).copyTo(it, overwrite = true) } to
+                        "application/vnd.android.package-archive"
+                } else {
+                    File(dir, "$name.apks").also { f ->
+                        ZipOutputStream(FileOutputStream(f)).use { zip ->
+                            addToZip(zip, File(ai.sourceDir), "base.apk")
+                            splits.forEach { sp -> addToZip(zip, File(sp), File(sp).name) }
+                        }
+                    } to "application/zip"
+                }
+                val uri = FileProvider.getUriForFile(ctx, "${ctx.packageName}.mods.provider", file)
+                val chooser = Intent.createChooser(
+                    Intent(Intent.ACTION_SEND).apply {
+                        type = mime
+                        putExtra(Intent.EXTRA_STREAM, uri)
+                        putExtra(Intent.EXTRA_SUBJECT, label)
+                        putExtra(Intent.EXTRA_TEXT, "$label ($pkg)")
+                        addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+                    },
+                    ctx.getString(R.string.mods_share_chooser)
+                ).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                withContext(Dispatchers.Main) { ctx.startActivity(chooser) }
+            } catch (_: Throwable) {
+                withContext(Dispatchers.Main) {
+                    Toast.makeText(ctx, R.string.mods_share_failed, Toast.LENGTH_SHORT).show()
+                }
+            }
+        }
+    }
+
+    private fun addToZip(zip: ZipOutputStream, src: File, name: String) {
+        zip.putNextEntry(ZipEntry(name)); FileInputStream(src).use { it.copyTo(zip) }; zip.closeEntry()
+    }
+
+    // ── Advanced permissions (Settings-based, no root) ─────────────────────
+
+    /**
+     * Shows a menu of Android Settings screens for special-access permissions.
+     * No root required. Ported from HomeLauncher's IntentUtil.openAdvancedPermissions().
+     */
+    fun openAdvancedPermissions(ctx: Context, pkg: String) {
+        data class Perm(val label: String, val intent: Intent)
+        fun appI(a: String) = Intent(a, Uri.parse("package:$pkg")).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        fun sysI(a: String) = Intent(a).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        val api = android.os.Build.VERSION.SDK_INT
+        val items = buildList {
+            add(Perm("Usage access",            sysI(Settings.ACTION_USAGE_ACCESS_SETTINGS)))
+            if (api >= 30) add(Perm("All files access", appI(Settings.ACTION_MANAGE_APP_ALL_FILES_ACCESS_PERMISSION)))
+            if (api >= 26) add(Perm("Install unknown apps", appI(Settings.ACTION_MANAGE_UNKNOWN_APP_SOURCES)))
+            add(Perm("Display over other apps", appI(Settings.ACTION_MANAGE_OVERLAY_PERMISSION)))
+            add(Perm("Modify system settings",  appI(Settings.ACTION_MANAGE_WRITE_SETTINGS)))
+            add(Perm("Notification access",     sysI(Settings.ACTION_NOTIFICATION_LISTENER_SETTINGS)))
+            add(Perm("Accessibility",           sysI(Settings.ACTION_ACCESSIBILITY_SETTINGS)))
+            if (api >= 23) add(Perm("Battery optimization",  sysI(Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS)))
+            if (api >= 23) add(Perm("Do Not Disturb access", sysI(Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS)))
+            if (api >= 24) add(Perm("Default apps",          sysI(Settings.ACTION_MANAGE_DEFAULT_APPS_SETTINGS)))
+            add(Perm("App info",                appI(Settings.ACTION_APPLICATION_DETAILS_SETTINGS)))
+        }
+        android.app.AlertDialog.Builder(themed(ctx))
+            .setTitle(R.string.mods_advanced_permissions)
+            .setItems(items.map { it.label }.toTypedArray()) { _, w ->
+                try { ctx.startActivity(items[w].intent) }
+                catch (_: Throwable) { Toast.makeText(ctx, R.string.mods_not_supported, Toast.LENGTH_SHORT).show() }
+            }
+            .setNegativeButton(android.R.string.cancel, null)
+            .show()
+    }
+}

