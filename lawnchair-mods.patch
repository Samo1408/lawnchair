+package app.lawnchair.mods.menu
+
+import android.app.Dialog
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+import android.os.Bundle
+import android.view.LayoutInflater
+import android.view.View
+import android.view.ViewGroup
+import android.widget.CheckBox
+import android.widget.TextView
+import android.widget.Toast
+import androidx.appcompat.app.AlertDialog
+import androidx.fragment.app.FragmentManager
+import androidx.lifecycle.lifecycleScope
+import app.lawnchair.mods.R
+import app.lawnchair.mods.drawer.AppDrawerFolderSupport
+import com.google.android.material.bottomsheet.BottomSheetBehavior
+import com.google.android.material.bottomsheet.BottomSheetDialog
+import com.google.android.material.bottomsheet.BottomSheetDialogFragment
+import com.google.android.material.chip.Chip
+import com.google.android.material.chip.ChipGroup
+import com.google.android.material.textfield.TextInputEditText
+import kotlinx.coroutines.launch
+
+class AppSelectionBottomSheet : BottomSheetDialogFragment() {
+
+    private lateinit var selectionManager: AppSelectionManager
+
+    /** Full list of packages visible in the current drawer view — used for Select All. */
+    private var allVisiblePackages: List<String> = emptyList()
+
+    companion object {
+        private const val TAG = "AppSelectionBottomSheet"
+
+        fun show(
+            fragmentManager: FragmentManager,
+            selectionManager: AppSelectionManager,
+            allVisiblePackages: List<String> = emptyList()
+        ): AppSelectionBottomSheet {
+            val sheet = AppSelectionBottomSheet()
+            sheet.selectionManager = selectionManager
+            sheet.allVisiblePackages = allVisiblePackages
+            sheet.show(fragmentManager, TAG)
+            return sheet
+        }
+    }
+
+    override fun onCreateDialog(savedInstanceState: Bundle?): Dialog {
+        return BottomSheetDialog(requireContext(), theme).apply {
+            behavior.state = BottomSheetBehavior.STATE_EXPANDED
+            behavior.skipCollapsed = false
+        }
+    }
+
+    override fun onCreateView(
+        inflater: LayoutInflater,
+        container: ViewGroup?,
+        savedInstanceState: Bundle?
+    ): View = inflater.inflate(R.layout.bottom_sheet_app_selection, container, false)
+
+    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
+        super.onViewCreated(view, savedInstanceState)
+
+        val tvCount = view.findViewById<TextView>(R.id.tvSelectionCount)
+        val chipGroup = view.findViewById<ChipGroup>(R.id.chipGroupSelectedApps)
+        val checkSelectAll = view.findViewById<CheckBox>(R.id.checkSelectAll)
+        val btnClear = view.findViewById<View>(R.id.btnClearSelection)
+        val actionMerge = view.findViewById<View>(R.id.actionMergeToFolder)
+        val actionShare = view.findViewById<View>(R.id.actionShare)
+        val actionUninstall = view.findViewById<View>(R.id.actionUninstall)
+
+        renderChips(chipGroup, tvCount, checkSelectAll)
+
+        checkSelectAll.setOnCheckedChangeListener { _, isChecked ->
+            if (isChecked) {
+                selectionManager.selectAll(allVisiblePackages)
+            } else {
+                selectionManager.clear()
+                if (selectionManager.selectedPackages.isEmpty()) {
+                    dismiss()
+                    return@setOnCheckedChangeListener
+                }
+            }
+            renderChips(chipGroup, tvCount, checkSelectAll)
+        }
+
+        btnClear.setOnClickListener {
+            selectionManager.clear()
+            dismiss()
+        }
+
+        actionMerge.setOnClickListener { showMergeToFolderDialog() }
+
+        actionShare.setOnClickListener {
+            selectionManager.shareSelected()
+            dismiss()
+        }
+
+        actionUninstall.setOnClickListener { confirmUninstall() }
+    }
+
+    private fun renderChips(chipGroup: ChipGroup, tvCount: TextView, checkSelectAll: CheckBox) {
+        chipGroup.removeAllViews()
+        val selected = selectionManager.selectedPackages
+
+        tvCount.text = "${selected.size} selected"
+
+        val allSelected = allVisiblePackages.isNotEmpty() &&
+                allVisiblePackages.all { it in selected }
+        val someSelected = !allSelected && selected.isNotEmpty()
+
+        // Update checkbox without re-triggering the listener
+        checkSelectAll.setOnCheckedChangeListener(null)
+        checkSelectAll.isChecked = allSelected
+        checkSelectAll.alpha = if (someSelected) 0.5f else 1f   // dim when partial
+        checkSelectAll.setOnCheckedChangeListener { _, isChecked ->
+            if (isChecked) {
+                selectionManager.selectAll(allVisiblePackages)
+            } else {
+                selectionManager.clear()
+                if (selectionManager.selectedPackages.isEmpty()) {
+                    dismiss()
+                    return@setOnCheckedChangeListener
+                }
+            }
+            renderChips(chipGroup, tvCount, checkSelectAll)
+        }
+
+        val pm = requireContext().packageManager
+        for (pkg in selected) {
+            val label = try {
+                pm.getApplicationLabel(pm.getApplicationInfo(pkg, 0)).toString()
+            } catch (e: PackageManager.NameNotFoundException) {
+                pkg
+            }
+
+            val chip = Chip(requireContext()).apply {
+                text = label
+                isCloseIconVisible = true
+                setOnCloseIconClickListener {
+                    selectionManager.toggle(pkg)
+                    if (selectionManager.selectedPackages.isEmpty()) {
+                        dismiss()
+                    } else {
+                        renderChips(chipGroup, tvCount, checkSelectAll)
+                    }
+                }
+            }
+            chipGroup.addView(chip)
+        }
+    }
+
+    private fun showMergeToFolderDialog() {
+        val ctx = requireContext()
+        lifecycleScope.launch {
+            val existing = AppDrawerFolderSupport.loadFolders(ctx)
+            val options = mutableListOf("+ Create new folder") + existing.map { it.name }
+
+            AlertDialog.Builder(ctx)
+                .setTitle("Merge to Folder")
+                .setItems(options.toTypedArray()) { _, which ->
+                    if (which == 0) {
+                        showCreateFolderDialog()
+                    } else {
+                        val folder = existing[which - 1]
+                        lifecycleScope.launch {
+                            AppDrawerFolderSupport.addAppsToFolder(
+                                ctx,
+                                folder.id,
+                                selectionManager.selectedPackages.toList()
+                            )
+                            selectionManager.clear()
+                            toast("Added to \"${folder.name}\"")
+                            dismiss()
+                        }
+                    }
+                }
+                .show()
+        }
+    }
+
+    private fun showCreateFolderDialog() {
+        val ctx = requireContext()
+        val dialogView = layoutInflater.inflate(R.layout.dialog_create_folder, null)
+        val input = dialogView.findViewById<TextInputEditText>(R.id.folderNameInput)
+
+        AlertDialog.Builder(ctx)
+            .setTitle("New Folder")
+            .setView(dialogView)
+            .setPositiveButton("Create") { _, _ ->
+                val name = input.text?.toString()?.trim()
+                if (name.isNullOrEmpty()) {
+                    toast("Folder name cannot be empty")
+                    return@setPositiveButton
+                }
+                lifecycleScope.launch {
+                    val folder = AppDrawerFolderSupport.createFolder(ctx, name)
+                    AppDrawerFolderSupport.addAppsToFolder(
+                        ctx,
+                        folder.id,
+                        selectionManager.selectedPackages.toList()
+                    )
+                    selectionManager.clear()
+                    toast("Folder \"$name\" created")
+                    dismiss()
+                }
+            }
+            .setNegativeButton("Cancel", null)
+            .show()
+    }
+
+    private fun confirmUninstall() {
+        val ctx = requireContext()
+        val count = selectionManager.selectedPackages.size
+        AlertDialog.Builder(ctx)
+            .setTitle("Uninstall $count app${if (count == 1) "" else "s"}?")
+            .setMessage("This will remove the selected apps from the device.")
+            .setPositiveButton("Uninstall") { _, _ ->
+                selectionManager.uninstallSelected { pkg ->
+                    val intent = Intent(Intent.ACTION_UNINSTALL_PACKAGE).apply {
+                        data = Uri.parse("package:$pkg")
+                        putExtra(Intent.EXTRA_RETURN_RESULT, true)
+                        addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                    }
+                    ctx.startActivity(intent)
+                }
+                dismiss()
+            }
+            .setNegativeButton("Cancel", null)
+            .show()
+    }
+
+    private fun toast(msg: String) =
+        Toast.makeText(requireContext(), msg, Toast.LENGTH_SHORT).show()
+}

