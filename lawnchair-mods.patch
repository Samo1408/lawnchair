@@ -0,0 +1,41 @@
+package app.lawnchair.mods
+
+import android.content.Context
+import android.content.pm.LauncherApps
+import android.os.Process
+import android.os.UserHandle
+import android.os.UserManager
+
+data class UserProfile(
+    val handle: UserHandle,
+    val serial: Long,
+    val label: String,
+    val isWork: Boolean,
+)
+
+/**
+ * Enumerates user profiles and their apps via the LauncherApps API.
+ * No root needed — works for work profiles and secondary users on the same device.
+ * Ported from HomeLauncher's AppRepository.loadAll() user-profile logic.
+ */
+object UserHelper {
+
+    fun getSecondaryProfiles(context: Context): List<UserProfile> {
+        val um = context.getSystemService(Context.USER_SERVICE) as UserManager
+        val me = Process.myUserHandle()
+        return um.userProfiles
+            .filter { it != me }
+            .map { h ->
+                val serial = um.getSerialNumberForUser(h)
+                UserProfile(h, serial, "user $serial", isWork = true)
+            }
+    }
+
+    /** Returns all package names visible under [profile] via LauncherApps — no root. */
+    fun getAppsForProfile(context: Context, profile: UserProfile): List<String> {
+        val la = context.getSystemService(Context.LAUNCHER_APPS_SERVICE) as LauncherApps
+        return runCatching {
+            la.getActivityList(null, profile.handle).map { it.applicationInfo.packageName }.distinct()
+        }.getOrDefault(emptyList())
+    }
+}

diff --git a/lawnchair/src/app/lawnchair/mods/DrawerFolderHelper.kt b/lawnchair/src/app/lawnchair/mods/DrawerFolderHelper.kt
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/mods/DrawerFolderHelper.kt
@@ -0,0 +1,55 @@
+package app.lawnchair.mods
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+data class DrawerFolder(val id: String, val name: String, val apps: MutableList<String> = mutableListOf())
+
+/** Simple JSON-backed folder store for the Select and Group-by-User shortcuts. */
+object DrawerFolderHelper {
+
+    private fun file(context: Context) = File(context.filesDir, "mods_drawer_folders.json")
+
+    suspend fun load(context: Context): List<DrawerFolder> = withContext(Dispatchers.IO) {
+        val f = file(context); if (!f.exists()) return@withContext emptyList()
+        val arr = JSONArray(f.readText())
+        (0 until arr.length()).map { i ->
+            val o    = arr.getJSONObject(i)
+            val apps = o.getJSONArray("apps")
+            DrawerFolder(
+                id   = o.getString("id"),
+                name = o.getString("name"),
+                apps = (0 until apps.length()).map { apps.getString(it) }.toMutableList(),
+            )
+        }
+    }
+
+    private suspend fun save(context: Context, folders: List<DrawerFolder>) = withContext(Dispatchers.IO) {
+        val arr = JSONArray()
+        folders.forEach { f ->
+            arr.put(JSONObject().apply {
+                put("id",   f.id)
+                put("name", f.name)
+                put("apps", JSONArray().also { a -> f.apps.forEach { a.put(it) } })
+            })
+        }
+        file(context).writeText(arr.toString())
+    }
+
+    suspend fun createFolder(context: Context, name: String, apps: List<String>): DrawerFolder {
+        val folders = load(context).toMutableList()
+        val folder  = DrawerFolder("folder_${System.currentTimeMillis()}", name, apps.toMutableList())
+        folders += folder; save(context, folders); return folder
+    }
+
+    suspend fun addToFolder(context: Context, folderId: String, apps: List<String>) {
+        val folders = load(context).toMutableList()
+        val i = folders.indexOfFirst { it.id == folderId }; if (i < 0) return
+        apps.forEach { p -> if (p !in folders[i].apps) folders[i].apps += p }
+        save(context, folders)
+    }
+}

diff --git a/lawnchair/src/app/lawnchair/ui/popup/ModsShortcuts.kt b/lawnchair/src/app/lawnchair/ui/popup/ModsShortcuts.kt
new file mode 100644
index 0000000..0000001
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/ui/popup/ModsShortcuts.kt
@@ -0,0 +1,340 @@
+package app.lawnchair.ui.popup
+
+import android.app.AlertDialog
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.view.ContextThemeWrapper
+import android.view.View
+import android.widget.EditText
+import android.widget.Toast
+import app.lawnchair.mods.DrawerFolder
+import app.lawnchair.mods.DrawerFolderHelper
+import app.lawnchair.mods.IntentUtil
+import app.lawnchair.mods.RootUtil
+import app.lawnchair.mods.UserHelper
+import app.lawnchair.mods.UserProfile
+import com.android.launcher3.Launcher
+import com.android.launcher3.R
+import com.android.launcher3.model.data.ItemInfo
+import com.android.launcher3.popup.SystemShortcut
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.SupervisorJob
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+object ModsShortcuts {
+
+    private val scope = CoroutineScope(Dispatchers.Main + SupervisorJob())
+
+    /**
+     * All AlertDialog.Builder calls use this wrapper so dialogs render with a
+     * light background and dark text even inside Lawnchair's dark/opaque theme.
+     * Ported from HomeLauncher's AppContextMenu.themed().
+     */
+    private fun themed(ctx: Context) =
+        ContextThemeWrapper(ctx, android.R.style.Theme_DeviceDefault_Light_Dialog_Alert)
+
+    private fun alertBuilder(ctx: Context) = AlertDialog.Builder(themed(ctx))
+
+    private fun toast(ctx: Context, msg: String) =
+        Toast.makeText(ctx, msg, Toast.LENGTH_SHORT).show()
+
+    // ─── Advanced Permissions ────────────────────────────────────────────────
+    // Ported from HomeLauncher IntentUtil.openAdvancedPermissions():
+    // opens Android Settings screens — no root required.
+
+    val ADVANCED_PERMISSIONS = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val pkg = itemInfo.targetComponent?.packageName ?: return@Factory null
+        AdvancedPermissionsShortcut(launcher, itemInfo, view, pkg)
+    }
+
+    private class AdvancedPermissionsShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View, private val pkg: String,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_info_no_shadow, R.string.mods_advanced_permissions, launcher, itemInfo, view) {
+        override fun onClick(v: View) { IntentUtil.openAdvancedPermissions(mTarget, pkg) }
+    }
+
+    // ─── Share App ───────────────────────────────────────────────────────────
+    // Ported from HomeLauncher IntentUtil.shareApp():
+    // split-APK aware, FileProvider-based, runs on IO coroutine.
+    // Requires the mods.provider entry in AndroidManifest.xml (see IntentUtil).
+
+    val SHARE_APP = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val pkg = itemInfo.targetComponent?.packageName ?: return@Factory null
+        ShareAppShortcut(launcher, itemInfo, view, pkg)
+    }
+
+    private class ShareAppShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View, private val pkg: String,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_install_no_shadow, R.string.mods_share_app, launcher, itemInfo, view) {
+        override fun onClick(v: View) {
+            val label = runCatching {
+                mTarget.packageManager.getApplicationLabel(
+                    mTarget.packageManager.getApplicationInfo(pkg, 0)
+                ).toString()
+            }.getOrDefault(pkg)
+            IntentUtil.shareApp(mTarget, pkg, label)
+        }
+    }
+
+    // ─── Install to Another User ─────────────────────────────────────────────
+    // Ported from HomeLauncher AppContextMenu.installToOtherUser():
+    // reads users via `pm list users` (root), installs via `pm install-existing`.
+    // Only shown when root can enumerate at least one additional user.
+
+    val INSTALL_TO_USER = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val pkg = itemInfo.targetComponent?.packageName ?: return@Factory null
+        InstallToUserShortcut(launcher, itemInfo, view, pkg)
+    }
+
+    private class InstallToUserShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View, private val pkg: String,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_install_no_shadow, R.string.mods_install_to_user, launcher, itemInfo, view) {
+        override fun onClick(v: View) {
+            val ctx = mTarget
+            scope.launch(Dispatchers.IO) {
+                val users = RootUtil.listUsers()
+                withContext(Dispatchers.Main) {
+                    if (users.isEmpty()) {
+                        toast(ctx, "Could not read user list — is root (su) granted?")
+                        return@withContext
+                    }
+                    val labels = users.map { "${it.second}  (id=${it.first})" }.toTypedArray()
+                    alertBuilder(ctx)
+                        .setTitle(R.string.mods_install_to_user)
+                        .setItems(labels) { _, which ->
+                            val (userId, userName) = users[which]
+                            scope.launch(Dispatchers.IO) {
+                                val ok = RootUtil.runAsRoot("pm install-existing --user $userId $pkg")
+                                withContext(Dispatchers.Main) {
+                                    toast(ctx, if (ok) "Installed to $userName" else "Install failed (root required)")
+                                }
+                            }
+                        }
+                        .setNegativeButton(android.R.string.cancel, null)
+                        .show()
+                }
+            }
+        }
+    }
+
+    // ─── Show Data Dir ───────────────────────────────────────────────────────
+    // Ported from HomeLauncher IntentUtil.openAppDataDir():
+    // always shown — if no supported root browser is installed an error toast
+    // appears on tap instead of silently hiding the shortcut.
+
+    val SHOW_DATA_DIR = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val pkg = itemInfo.targetComponent?.packageName ?: return@Factory null
+        ShowDataDirShortcut(launcher, itemInfo, view, pkg)
+    }
+
+    private class ShowDataDirShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View, private val pkg: String,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_info_no_shadow, R.string.mods_show_data_dir, launcher, itemInfo, view) {
+        override fun onClick(v: View) { IntentUtil.openAppDataDir(mTarget, pkg) }
+    }
+
+    // ─── Show App Dir ────────────────────────────────────────────────────────
+    // Ported from HomeLauncher IntentUtil.openAppInstallDir():
+    // resolves the parent of the APK source dir before opening the browser.
+
+    val SHOW_APP_DIR = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val pkg = itemInfo.targetComponent?.packageName ?: return@Factory null
+        ShowAppDirShortcut(launcher, itemInfo, view, pkg)
+    }
+
+    private class ShowAppDirShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View, private val pkg: String,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_install_no_shadow, R.string.mods_show_app_dir, launcher, itemInfo, view) {
+        override fun onClick(v: View) { IntentUtil.openAppInstallDir(mTarget, pkg) }
+    }
+
+    // ─── Group by User Profile ───────────────────────────────────────────────
+    // Uses LauncherApps API (no root) to enumerate work-profile / secondary-user
+    // apps, then creates one DrawerFolder per profile.
+    // Ported from HomeLauncher AppRepository.groupByUser() + DesktopStore.
+
+    val GROUP_BY_USER = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val profiles = UserHelper.getSecondaryProfiles(launcher)
+        if (profiles.isEmpty()) return@Factory null
+        GroupByUserShortcut(launcher, itemInfo, view, profiles)
+    }
+
+    private class GroupByUserShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View,
+        private val profiles: List<UserProfile>,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_install_no_shadow, R.string.mods_group_by_user, launcher, itemInfo, view) {
+        override fun onClick(v: View) {
+            val ctx = mTarget
+            scope.launch {
+                var created = 0
+                profiles.forEach { profile ->
+                    val apps = UserHelper.getAppsForProfile(ctx, profile)
+                    if (apps.isNotEmpty()) {
+                        DrawerFolderHelper.createFolder(ctx, profile.label, apps)
+                        created++
+                    }
+                }
+                toast(
+                    ctx,
+                    if (created > 0) "Created $created folder(s) for user profiles"
+                    else "No apps found for secondary profiles"
+                )
+            }
+        }
+    }
+
+    // ─── Select ──────────────────────────────────────────────────────────────
+    // Ported from HomeLauncher's multi-select flow:
+    //   1. If secondary profiles exist, pick a profile first.
+    //   2. Load that profile's apps via LauncherApps (no root needed).
+    //   3. Show a multi-choice dialog with the app list.
+    //   4. On "Next", offer: Merge to Folder, Share, or Uninstall.
+
+    val SELECT = SystemShortcut.Factory<Launcher> { launcher, itemInfo, view ->
+        val pkg = itemInfo.targetComponent?.packageName ?: return@Factory null
+        SelectShortcut(launcher, itemInfo, view, pkg)
+    }
+
+    private class SelectShortcut(
+        launcher: Launcher, itemInfo: ItemInfo, view: View, private val pkg: String,
+    ) : SystemShortcut<Launcher>(R.drawable.ic_uninstall_no_shadow, R.string.mods_select, launcher, itemInfo, view) {
+
+        override fun onClick(v: View) {
+            val ctx = mTarget
+            val profiles = UserHelper.getSecondaryProfiles(ctx)
+            if (profiles.isEmpty()) {
+                showAppListForPrimary(ctx)
+            } else {
+                val entries = (listOf("Primary User") + profiles.map { it.label }).toTypedArray()
+                alertBuilder(ctx)
+                    .setTitle("Select User Profile")
+                    .setItems(entries) { _, which ->
+                        if (which == 0) showAppListForPrimary(ctx)
+                        else showAppListForProfile(ctx, profiles[which - 1])
+                    }
+                    .show()
+            }
+        }
+
+        /** Primary user: use PackageManager (no root, no LauncherApps needed). */
+        private fun showAppListForPrimary(ctx: Context) {
+            scope.launch(Dispatchers.IO) {
+                val pm = ctx.packageManager
+                val apps = pm.getInstalledApplications(android.content.pm.PackageManager.MATCH_ALL)
+                    .filter { it.flags and android.content.pm.ApplicationInfo.FLAG_SYSTEM == 0 }
+                    .sortedBy { pm.getApplicationLabel(it).toString() }
+                    .map { it.packageName to pm.getApplicationLabel(it).toString() }
+                withContext(Dispatchers.Main) { showSelectionDialog(ctx, apps, null) }
+            }
+        }
+
+        /**
+         * Secondary user / work profile: use LauncherApps.getActivityList() —
+         * no root required. Ported from HomeLauncher AppRepository.loadAll().
+         */
+        private fun showAppListForProfile(ctx: Context, profile: UserProfile) {
+            scope.launch(Dispatchers.IO) {
+                val pm = ctx.packageManager
+                val pkgs = UserHelper.getAppsForProfile(ctx, profile)
+                val apps = pkgs
+                    .map { p ->
+                        val label = runCatching {
+                            pm.getApplicationLabel(pm.getApplicationInfo(p, 0)).toString()
+                        }.getOrDefault(p)
+                        p to label
+                    }
+                    .sortedBy { it.second }
+                withContext(Dispatchers.Main) { showSelectionDialog(ctx, apps, profile.label) }
+            }
+        }
+
+        private fun showSelectionDialog(
+            ctx: Context,
+            apps: List<Pair<String, String>>,
+            profileLabel: String?,
+        ) {
+            if (apps.isEmpty()) {
+                toast(ctx, "No apps found${if (profileLabel != null) " for $profileLabel" else ""}")
+                return
+            }
+            val labels  = apps.map { it.second }.toTypedArray()
+            val pkgs    = apps.map { it.first }
+            val checked = BooleanArray(apps.size) { apps[it].first == pkg }
+            alertBuilder(ctx)
+                .setTitle("Select Apps${if (profileLabel != null) " ($profileLabel)" else ""}")
+                .setMultiChoiceItems(labels, checked) { _, i, v -> checked[i] = v }
+                .setPositiveButton("Next") { _, _ ->
+                    val selected = pkgs.filterIndexed { i, _ -> checked[i] }
+                    if (selected.isNotEmpty()) showActionDialog(ctx, selected)
+                }
+                .setNegativeButton(android.R.string.cancel, null)
+                .show()
+        }
+
+        private fun showActionDialog(ctx: Context, selected: List<String>) {
+            alertBuilder(ctx)
+                .setTitle("${selected.size} app${if (selected.size == 1) "" else "s"} selected")
+                .setItems(arrayOf("Merge to Folder", "Share All", "Uninstall All")) { _, which ->
+                    when (which) {
+                        0 -> showMergeDialog(ctx, selected)
+                        1 -> selected.forEach { p ->
+                            val label = runCatching {
+                                ctx.packageManager.getApplicationLabel(
+                                    ctx.packageManager.getApplicationInfo(p, 0)
+                                ).toString()
+                            }.getOrDefault(p)
+                            IntentUtil.shareApp(ctx, p, label)
+                        }
+                        2 -> selected.forEach { p ->
+                            ctx.startActivity(
+                                Intent(Intent.ACTION_DELETE, Uri.parse("package:$p"))
+                                    .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+                            )
+                        }
+                    }
+                }
+                .show()
+        }
+
+        private fun showMergeDialog(ctx: Context, selected: List<String>) {
+            scope.launch {
+                val existing = DrawerFolderHelper.load(ctx)
+                val options  = (listOf("+ New folder") + existing.map { it.name }).toTypedArray()
+                withContext(Dispatchers.Main) {
+                    alertBuilder(ctx)
+                        .setTitle("Merge to Folder")
+                        .setItems(options) { _, which ->
+                            if (which == 0) showCreateFolderDialog(ctx, selected)
+                            else scope.launch {
+                                DrawerFolderHelper.addToFolder(ctx, existing[which - 1].id, selected)
+                                withContext(Dispatchers.Main) {
+                                    toast(ctx, "Added to \"${existing[which - 1].name}\"")
+                                }
+                            }
+                        }
+                        .show()
+                }
+            }
+        }
+
+        private fun showCreateFolderDialog(ctx: Context, selected: List<String>) {
+            val input = EditText(themed(ctx)).apply { hint = "Folder name" }
+            alertBuilder(ctx)
+                .setTitle("New Folder")
+                .setView(input)
+                .setPositiveButton("Create") { _, _ ->
+                    val name = input.text.toString().trim()
+                    if (name.isEmpty()) { toast(ctx, "Name cannot be empty"); return@setPositiveButton }
+                    scope.launch {
+                        DrawerFolderHelper.createFolder(ctx, name, selected)
+                        withContext(Dispatchers.Main) { toast(ctx, "Folder \"$name\" created") }
+                    }
+                }
+                .setNegativeButton(android.R.string.cancel, null)
+                .show()
+        }
+    }
+}

