@@ -0,0 +1,77 @@
+package app.lawnchair.mods.apk
+
+import android.content.Context
+import android.content.Intent
+import android.content.pm.ApplicationInfo
+import android.content.pm.PackageManager
+import androidx.core.content.FileProvider
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.io.FileInputStream
+import java.io.FileOutputStream
+import java.util.zip.ZipEntry
+import java.util.zip.ZipOutputStream
+
+object ApkShareHelper {
+
+    suspend fun shareApp(context: Context, packageName: String) = withContext(Dispatchers.IO) {
+        val appInfo = context.packageManager.getApplicationInfo(packageName, 0)
+        val sourceDir = appInfo.sourceDir
+        val splitSourceDirs = appInfo.splitSourceDirs
+
+        val fileToShare: File = if (splitSourceDirs.isNullOrEmpty()) {
+            File(sourceDir)
+        } else {
+            mergeToApks(context, packageName, sourceDir, splitSourceDirs)
+        }
+
+        val uri = FileProvider.getUriForFile(
+            context,
+            "${context.packageName}.mods.fileprovider",
+            fileToShare
+        )
+
+        val intent = Intent(Intent.ACTION_SEND).apply {
+            type = if (splitSourceDirs.isNullOrEmpty()) "application/vnd.android.package-archive"
+                   else "application/octet-stream"
+            putExtra(Intent.EXTRA_STREAM, uri)
+            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_ACTIVITY_NEW_TASK)
+        }
+
+        context.startActivity(Intent.createChooser(intent, "Share ${getAppLabel(context, packageName)}").apply {
+            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        })
+    }
+
+    private suspend fun mergeToApks(
+        context: Context,
+        packageName: String,
+        baseApk: String,
+        splits: Array<String>
+    ): File = withContext(Dispatchers.IO) {
+        val outputDir = context.cacheDir.resolve("shared_apks").also { it.mkdirs() }
+        val outFile = outputDir.resolve("$packageName.apks")
+
+        ZipOutputStream(FileOutputStream(outFile)).use { zip ->
+            val allApks = listOf(File(baseApk)) + splits.map { File(it) }
+            for (apk in allApks) {
+                zip.putNextEntry(ZipEntry(apk.name))
+                FileInputStream(apk).copyTo(zip)
+                zip.closeEntry()
+            }
+        }
+
+        outFile
+    }
+
+    private fun getAppLabel(context: Context, packageName: String): String {
+        return try {
+            val pm = context.packageManager
+            val appInfo = pm.getApplicationInfo(packageName, 0)
+            pm.getApplicationLabel(appInfo).toString()
+        } catch (e: PackageManager.NameNotFoundException) {
+            packageName
+        }
+    }
+}

diff --git a/app/src/main/java/app/lawnchair/mods/drawer/AppDrawerFolderSupport.kt b/app/src/main/java/app/lawnchair/mods/drawer/AppDrawerFolderSupport.kt
