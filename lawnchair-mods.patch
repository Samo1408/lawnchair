+package app.lawnchair.mods.menu
+
+import android.content.Context
+import android.widget.Toast
+import app.lawnchair.mods.apk.ApkShareHelper
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+class AppSelectionManager(
+    private val context: Context,
+    private val scope: CoroutineScope
+) {
+
+    private val _selectedPackages = mutableSetOf<String>()
+    val selectedPackages: Set<String> get() = _selectedPackages
+
+    val isActive get() = _selectedPackages.isNotEmpty()
+
+    fun toggle(packageName: String): Boolean {
+        return if (packageName in _selectedPackages) {
+            _selectedPackages.remove(packageName)
+            false
+        } else {
+            _selectedPackages.add(packageName)
+            true
+        }
+    }
+
+    fun isSelected(packageName: String) = packageName in _selectedPackages
+
+    fun clear() = _selectedPackages.clear()
+
+    fun selectAll(packages: List<String>) {
+        _selectedPackages.addAll(packages)
+    }
+
+    fun shareSelected() {
+        val packages = _selectedPackages.toList()
+        scope.launch {
+            for (pkg in packages) {
+                try {
+                    ApkShareHelper.shareApp(context, pkg)
+                } catch (e: Exception) {
+                    withContext(Dispatchers.Main) {
+                        Toast.makeText(context, "Failed to share $pkg: ${e.message}", Toast.LENGTH_SHORT).show()
+                    }
+                }
+            }
+        }
+    }
+
+    fun uninstallSelected(onUninstall: (String) -> Unit) {
+        val packages = _selectedPackages.toList()
+        for (pkg in packages) {
+            onUninstall(pkg)
+        }
+        clear()
+    }
+
+    var onMergeToFolder: ((Set<String>) -> Unit)? = null
+
+    fun mergeSelectedToFolder() {
+        onMergeToFolder?.invoke(_selectedPackages.toSet())
+        clear()
+    }
+}

