@@ -0,0 +1,88 @@
+package app.lawnchair.mods.drawer
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+data class DrawerFolder(
+    val id: String,
+    val name: String,
+    val apps: MutableList<String> = mutableListOf()
+)
+
+object AppDrawerFolderSupport {
+
+    private const val FOLDERS_FILE = "drawer_folders.json"
+
+    private fun foldersFile(context: Context): File =
+        File(context.filesDir, FOLDERS_FILE)
+
+    suspend fun loadFolders(context: Context): List<DrawerFolder> = withContext(Dispatchers.IO) {
+        val file = foldersFile(context)
+        if (!file.exists()) return@withContext emptyList()
+        val json = JSONArray(file.readText())
+        (0 until json.length()).map { i ->
+            val obj = json.getJSONObject(i)
+            val apps = obj.getJSONArray("apps")
+            DrawerFolder(
+                id = obj.getString("id"),
+                name = obj.getString("name"),
+                apps = (0 until apps.length()).map { apps.getString(it) }.toMutableList()
+            )
+        }
+    }
+
+    suspend fun saveFolders(context: Context, folders: List<DrawerFolder>) = withContext(Dispatchers.IO) {
+        val json = JSONArray()
+        for (folder in folders) {
+            val obj = JSONObject().apply {
+                put("id", folder.id)
+                put("name", folder.name)
+                val apps = JSONArray()
+                folder.apps.forEach { apps.put(it) }
+                put("apps", apps)
+            }
+            json.put(obj)
+        }
+        foldersFile(context).writeText(json.toString())
+    }
+
+    suspend fun createFolder(context: Context, name: String): DrawerFolder {
+        val folders = loadFolders(context).toMutableList()
+        val folder = DrawerFolder(
+            id = "folder_${System.currentTimeMillis()}",
+            name = name
+        )
+        folders.add(folder)
+        saveFolders(context, folders)
+        return folder
+    }
+
+    suspend fun addAppsToFolder(context: Context, folderId: String, packageNames: List<String>) {
+        val folders = loadFolders(context).toMutableList()
+        val index = folders.indexOfFirst { it.id == folderId }
+        if (index == -1) return
+        val folder = folders[index]
+        packageNames.forEach { pkg ->
+            if (pkg !in folder.apps) folder.apps.add(pkg)
+        }
+        folders[index] = folder
+        saveFolders(context, folders)
+    }
+
+    suspend fun removeFolder(context: Context, folderId: String) {
+        val folders = loadFolders(context).filter { it.id != folderId }
+        saveFolders(context, folders)
+    }
+
+    suspend fun renameFolder(context: Context, folderId: String, newName: String) {
+        val folders = loadFolders(context).toMutableList()
+        val index = folders.indexOfFirst { it.id == folderId }
+        if (index == -1) return
+        folders[index] = folders[index].copy(name = newName)
+        saveFolders(context, folders)
+    }
+}

