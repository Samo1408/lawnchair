+package app.lawnchair.mods.drawer
+
+import android.content.Context
+import android.content.pm.LauncherApps
+import android.content.pm.PackageManager
+import android.os.UserHandle
+import android.os.UserManager
+import app.lawnchair.mods.multiuser.UserProfile
+
+data class AppEntry(
+    val packageName: String,
+    val label: String,
+    val userHandle: UserHandle
+)
+
+data class UserFolder(
+    val profile: UserProfile,
+    val apps: List<AppEntry>
+)
+
+object WorkTabUserFolder {
+
+    fun buildWorkFolders(context: Context): List<UserFolder> {
+        val um = context.getSystemService(Context.USER_SERVICE) as UserManager
+        val la = context.getSystemService(Context.LAUNCHER_APPS_SERVICE) as LauncherApps
+        val pm = context.packageManager
+
+        return um.userProfiles
+            .filter { it.identifier != 0 }
+            .map { handle ->
+                val userId = handle.identifier
+                val apps = la.getActivityList(null, handle).map { info ->
+                    AppEntry(
+                        packageName = info.applicationInfo.packageName,
+                        label = info.label.toString(),
+                        userHandle = handle
+                    )
+                }
+                UserFolder(
+                    profile = UserProfile(id = userId, name = "user $userId"),
+                    apps = apps
+                )
+            }
+    }
+
+    fun getPrimaryUserApps(context: Context): List<AppEntry> {
+        val la = context.getSystemService(Context.LAUNCHER_APPS_SERVICE) as LauncherApps
+        val um = context.getSystemService(Context.USER_SERVICE) as UserManager
+        val primaryHandle = um.userProfiles.first { it.identifier == 0 }
+
+        return la.getActivityList(null, primaryHandle).map { info ->
+            AppEntry(
+                packageName = info.applicationInfo.packageName,
+                label = info.label.toString(),
+                userHandle = primaryHandle
+            )
+        }
+    }
+}

