@@ -0,0 +1,41 @@
+package app.lawnchair.mods
+
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+
+object RootExplorerHelper {
+
+    private val EXPLORERS = listOf(
+        "com.mixplorer",
+        "com.mixplorer.silver",
+        "bin.mt.plus.canary",
+        "bin.mt.plus",
+    )
+
+    fun openPath(context: Context, path: String) {
+        val explorer = findExplorer(context)
+            ?: throw IllegalStateException("No supported root explorer installed (MiXplorer / MT Manager)")
+        val intent = Intent(Intent.ACTION_VIEW).apply {
+            setPackage(explorer)
+            data = Uri.parse("file://$path")
+            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        }
+        context.startActivity(intent)
+    }
+
+    fun openDataDir(context: Context, packageName: String) =
+        openPath(context, "/data/data/$packageName")
+
+    fun openAppDir(context: Context, packageName: String) {
+        val apk = context.packageManager.getApplicationInfo(packageName, 0).publicSourceDir
+        openPath(context, apk)
+    }
+
+    fun findExplorer(context: Context): String? =
+        EXPLORERS.firstOrNull {
+            runCatching { context.packageManager.getPackageInfo(it, 0) }.isSuccess
+        }
+
+    fun hasExplorer(context: Context) = findExplorer(context) != null
+}

diff --git a/lawnchair/src/app/lawnchair/ui/popup/ModsShortcuts.kt b/lawnchair/src/app/lawnchair/ui/popup/ModsShortcuts.kt
new file mode 100644
index 0000000..7cfd209
