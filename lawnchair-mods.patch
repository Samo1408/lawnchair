+package app.lawnchair.mods.root
+
+import android.content.Context
+import android.content.Intent
+import android.content.pm.PackageManager
+import android.net.Uri
+
+object RootExplorerHelper {
+
+    private val SUPPORTED_EXPLORERS = listOf(
+        "com.mixplorer",
+        "com.mixplorer.silver",
+        "bin.mt.plus.canary",
+        "bin.mt.plus"
+    )
+
+    fun openPath(context: Context, path: String) {
+        val explorer = findInstalledExplorer(context)
+            ?: throw IllegalStateException("No supported root explorer installed")
+
+        val intent = Intent(Intent.ACTION_VIEW).apply {
+            setPackage(explorer)
+            data = Uri.parse("file://$path")
+            addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        }
+        context.startActivity(intent)
+    }
+
+    fun openDataDir(context: Context, packageName: String) {
+        openPath(context, "/data/data/$packageName")
+    }
+
+    fun openAppDir(context: Context, packageName: String) {
+        val apkPath = context.packageManager
+            .getApplicationInfo(packageName, 0)
+            .publicSourceDir
+        openPath(context, apkPath)
+    }
+
+    fun findInstalledExplorer(context: Context): String? {
+        val pm = context.packageManager
+        return SUPPORTED_EXPLORERS.firstOrNull { pkg ->
+            try {
+                pm.getPackageInfo(pkg, 0)
+                true
+            } catch (e: PackageManager.NameNotFoundException) {
+                false
+            }
+        }
+    }
+
+    fun hasInstalledExplorer(context: Context): Boolean =
+        findInstalledExplorer(context) != null
+}

