@@ -0,0 +1,39 @@
+package app.lawnchair.mods.root
+
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.BufferedReader
+import java.io.InputStreamReader
+import java.io.OutputStreamWriter
+
+object RootCommandHelper {
+
+    data class RootResult(val output: String, val error: String, val exitCode: Int) {
+        val success get() = exitCode == 0
+    }
+
+    suspend fun exec(vararg commands: String): RootResult = withContext(Dispatchers.IO) {
+        try {
+            val process = Runtime.getRuntime().exec("su")
+            val writer = OutputStreamWriter(process.outputStream)
+            for (cmd in commands) {
+                writer.write("$cmd\n")
+            }
+            writer.write("exit\n")
+            writer.flush()
+            writer.close()
+
+            val output = BufferedReader(InputStreamReader(process.inputStream)).readText().trim()
+            val error = BufferedReader(InputStreamReader(process.errorStream)).readText().trim()
+            val exitCode = process.waitFor()
+            RootResult(output, error, exitCode)
+        } catch (e: Exception) {
+            RootResult("", e.message ?: "Unknown error", -1)
+        }
+    }
+
+    suspend fun isRootAvailable(): Boolean {
+        val result = exec("id")
+        return result.success && result.output.contains("uid=0")
+    }
+}

