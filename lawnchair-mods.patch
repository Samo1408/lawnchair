@@ -0,0 +1,19 @@
+package app.lawnchair.mods
+
+object AdvancedPermissionsHelper {
+
+    suspend fun grantUsageStats(pkg: String) =
+        RootCommandHelper.exec("appops set $pkg PACKAGE_USAGE_STATS allow")
+
+    suspend fun grantAllFiles(pkg: String) =
+        RootCommandHelper.exec("appops set $pkg MANAGE_EXTERNAL_STORAGE allow")
+
+    suspend fun grantUnknownSources(pkg: String) =
+        RootCommandHelper.exec("appops set $pkg REQUEST_INSTALL_PACKAGES allow")
+
+    suspend fun grantAll(pkg: String) = listOf(
+        grantUsageStats(pkg),
+        grantAllFiles(pkg),
+        grantUnknownSources(pkg),
+    )
+}

diff --git a/lawnchair/src/app/lawnchair/mods/ApkShareHelper.kt b/lawnchair/src/app/lawnchair/mods/ApkShareHelper.kt
new file mode 100644
index 0000000..70ac07c
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/mods/ApkShareHelper.kt
@@ -0,0 +1,54 @@
+package app.lawnchair.mods
+
+import android.content.Context
+import android.content.Intent
+import androidx.core.content.FileProvider
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import java.io.File
+import java.io.FileInputStream
+import java.io.FileOutputStream
+import java.util.zip.ZipEntry
+import java.util.zip.ZipOutputStream
+
+object ApkShareHelper {
+
+    suspend fun shareApp(context: Context, packageName: String) = withContext(Dispatchers.IO) {
+        val appInfo = context.packageManager.getApplicationInfo(packageName, 0)
+        val splits  = appInfo.splitSourceDirs
+        val file = if (splits.isNullOrEmpty()) {
+            File(appInfo.sourceDir)
+        } else {
+            mergeToApks(context, packageName, appInfo.sourceDir, splits)
+        }
+        val uri  = FileProvider.getUriForFile(context, "${context.packageName}.mods.provider", file)
+        val mime = if (splits.isNullOrEmpty()) "application/vnd.android.package-archive"
+                   else "application/octet-stream"
+        val intent = Intent(Intent.ACTION_SEND).apply {
+            type = mime
+            putExtra(Intent.EXTRA_STREAM, uri)
+            addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_ACTIVITY_NEW_TASK)
+        }
+        context.startActivity(
+            Intent.createChooser(intent, "Share APK").addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        )
+    }
+
+    private suspend fun mergeToApks(
+        context: Context,
+        pkg: String,
+        base: String,
+        splits: Array<String>,
+    ): File = withContext(Dispatchers.IO) {
+        val dir = File(context.cacheDir, "mods_apks").also { it.mkdirs() }
+        val out = File(dir, "$pkg.apks")
+        ZipOutputStream(FileOutputStream(out)).use { zip ->
+            for (apk in listOf(File(base)) + splits.map { File(it) }) {
+                zip.putNextEntry(ZipEntry(apk.name))
+                FileInputStream(apk).copyTo(zip)
+                zip.closeEntry()
+            }
+        }
+        out
+    }
+}

diff --git a/lawnchair/src/app/lawnchair/mods/DrawerFolderHelper.kt b/lawnchair/src/app/lawnchair/mods/DrawerFolderHelper.kt
new file mode 100644
index 0000000..0bad932
--- /dev/null
+++ b/lawnchair/src/app/lawnchair/mods/DrawerFolderHelper.kt
@@ -0,0 +1,58 @@
+package app.lawnchair.mods
+
+import android.content.Context
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+
+data class DrawerFolder(val id: String, val name: String, val apps: MutableList<String> = mutableListOf())
+
+object DrawerFolderHelper {
+
+    private fun file(context: Context) = File(context.filesDir, "mods_drawer_folders.json")
+
+    suspend fun load(context: Context): List<DrawerFolder> = withContext(Dispatchers.IO) {
+        val f = file(context)
+        if (!f.exists()) return@withContext emptyList()
+        val arr = JSONArray(f.readText())
+        (0 until arr.length()).map { i ->
+            val o = arr.getJSONObject(i)
+            val apps = o.getJSONArray("apps")
+            DrawerFolder(
+                id = o.getString("id"),
+                name = o.getString("name"),
+                apps = (0 until apps.length()).map { apps.getString(it) }.toMutableList(),
+            )
+        }
+    }
+
+    suspend fun save(context: Context, folders: List<DrawerFolder>) = withContext(Dispatchers.IO) {
+        val arr = JSONArray()
+        folders.forEach { folder ->
+            arr.put(JSONObject().apply {
+                put("id", folder.id)
+                put("name", folder.name)
+                put("apps", JSONArray().also { a -> folder.apps.forEach { a.put(it) } })
+            })
+        }
+        file(context).writeText(arr.toString())
+    }
+
+    suspend fun createFolder(context: Context, name: String, apps: List<String>): DrawerFolder {
+        val folders = load(context).toMutableList()
+        val folder  = DrawerFolder("folder_${System.currentTimeMillis()}", name, apps.toMutableList())
+        folders.add(folder)
+        save(context, folders)
+        return folder
+    }
+
+    suspend fun addToFolder(context: Context, folderId: String, apps: List<String>) {
+        val folders = load(context).toMutableList()
+        val i = folders.indexOfFirst { it.id == folderId }
+        if (i < 0) return
+        apps.forEach { pkg -> if (pkg !in folders[i].apps) folders[i].apps.add(pkg) }
+        save(context, folders)
+    }
+}

