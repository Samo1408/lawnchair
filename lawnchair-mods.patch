+package app.lawnchair.mods.permissions
+
+import app.lawnchair.mods.root.RootCommandHelper
+
+object AdvancedPermissionsHelper {
+
+    suspend fun grantUsageStats(packageName: String): RootCommandHelper.RootResult {
+        return RootCommandHelper.exec(
+            "appops set $packageName PACKAGE_USAGE_STATS allow"
+        )
+    }
+
+    suspend fun grantAllFiles(packageName: String): RootCommandHelper.RootResult {
+        return RootCommandHelper.exec(
+            "appops set $packageName MANAGE_EXTERNAL_STORAGE allow"
+        )
+    }
+
+    suspend fun grantInstallUnknownSources(packageName: String): RootCommandHelper.RootResult {
+        return RootCommandHelper.exec(
+            "appops set $packageName REQUEST_INSTALL_PACKAGES allow"
+        )
+    }
+
+    suspend fun grantAll(packageName: String): List<RootCommandHelper.RootResult> {
+        return listOf(
+            grantUsageStats(packageName),
+            grantAllFiles(packageName),
+            grantInstallUnknownSources(packageName)
+        )
+    }
+
+    suspend fun revokeUsageStats(packageName: String): RootCommandHelper.RootResult {
+        return RootCommandHelper.exec(
+            "appops set $packageName PACKAGE_USAGE_STATS deny"
+        )
+    }
+
+    suspend fun revokeAllFiles(packageName: String): RootCommandHelper.RootResult {
+        return RootCommandHelper.exec(
+            "appops set $packageName MANAGE_EXTERNAL_STORAGE deny"
+        )
+    }
+
+    suspend fun revokeInstallUnknownSources(packageName: String): RootCommandHelper.RootResult {
+        return RootCommandHelper.exec(
+            "appops set $packageName REQUEST_INSTALL_PACKAGES deny"
+        )
+    }
+}

