+package app.lawnchair.mods.multiuser
+
+import android.content.Context
+import android.os.UserHandle
+import android.os.UserManager
+import app.lawnchair.mods.root.RootCommandHelper
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.withContext
+
+data class UserProfile(val id: Int, val name: String)
+
+object MultiUserHelper {
+
+    fun getSecondaryUsers(context: Context): List<UserProfile> {
+        val um = context.getSystemService(Context.USER_SERVICE) as UserManager
+        return um.userProfiles
+            .mapNotNull { handle ->
+                val userId = handle.identifier
+                if (userId == 0) null
+                else UserProfile(
+                    id = userId,
+                    name = "user $userId"
+                )
+            }
+    }
+
+    suspend fun installToUser(packageName: String, userId: Int): RootCommandHelper.RootResult {
+        return RootCommandHelper.exec("pm install-existing --user $userId $packageName")
+    }
+
+    suspend fun getInstalledPackagesForUser(userId: Int): List<String> =
+        withContext(Dispatchers.IO) {
+            val result = RootCommandHelper.exec("pm list packages --user $userId")
+            if (!result.success) return@withContext emptyList()
+            result.output.lines()
+                .filter { it.startsWith("package:") }
+                .map { it.removePrefix("package:").trim() }
+        }
+
+    suspend fun isPackageInstalledForUser(packageName: String, userId: Int): Boolean {
+        val packages = getInstalledPackagesForUser(userId)
+        return packageName in packages
+    }
+}

