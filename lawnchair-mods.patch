@@ -0,0 +1,108 @@
+package app.lawnchair.mods.menu
+
+import android.content.Context
+import android.view.LayoutInflater
+import android.widget.Toast
+import androidx.appcompat.app.AlertDialog
+import app.lawnchair.mods.apk.ApkShareHelper
+import app.lawnchair.mods.multiuser.MultiUserHelper
+import app.lawnchair.mods.permissions.AdvancedPermissionsHelper
+import app.lawnchair.mods.root.RootCommandHelper
+import app.lawnchair.mods.root.RootExplorerHelper
+import kotlinx.coroutines.CoroutineScope
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.launch
+import kotlinx.coroutines.withContext
+
+data class AppMenuItem(val label: String, val action: suspend () -> Unit)
+
+class AppLongPressMenuExtension(
+    private val context: Context,
+    private val packageName: String,
+    private val scope: CoroutineScope
+) {
+
+    fun buildMenuItems(): List<AppMenuItem> = listOf(
+        AppMenuItem("Advanced Permissions") { showAdvancedPermissionsDialog() },
+        AppMenuItem("Share App") { shareApp() },
+        AppMenuItem("Install to Another User") { showInstallToUserDialog() },
+        AppMenuItem("Show Data Dir") { showDataDir() },
+        AppMenuItem("Show App Dir") { showAppDir() },
+        AppMenuItem("Select") { onSelectRequested() }
+    )
+
+    private suspend fun showAdvancedPermissionsDialog() = withContext(Dispatchers.Main) {
+        val options = arrayOf(
+            "Grant Usage Stats",
+            "Grant Access All Files",
+            "Grant Install Unknown Sources",
+            "Grant All"
+        )
+        AlertDialog.Builder(context)
+            .setTitle("Advanced Permissions")
+            .setItems(options) { _, which ->
+                scope.launch {
+                    val results = when (which) {
+                        0 -> listOf(AdvancedPermissionsHelper.grantUsageStats(packageName))
+                        1 -> listOf(AdvancedPermissionsHelper.grantAllFiles(packageName))
+                        2 -> listOf(AdvancedPermissionsHelper.grantInstallUnknownSources(packageName))
+                        else -> AdvancedPermissionsHelper.grantAll(packageName)
+                    }
+                    val allOk = results.all { it.success }
+                    toast(if (allOk) "Permissions granted" else "Failed: ${results.firstOrNull { !it.success }?.error}")
+                }
+            }
+            .show()
+    }
+
+    private suspend fun shareApp() {
+        try {
+            ApkShareHelper.shareApp(context, packageName)
+        } catch (e: Exception) {
+            withContext(Dispatchers.Main) { toast("Share failed: ${e.message}") }
+        }
+    }
+
+    private suspend fun showInstallToUserDialog() = withContext(Dispatchers.Main) {
+        val users = MultiUserHelper.getSecondaryUsers(context)
+        if (users.isEmpty()) {
+            toast("No secondary users found")
+            return@withContext
+        }
+        val labels = users.map { it.name }.toTypedArray()
+        AlertDialog.Builder(context)
+            .setTitle("Install to User")
+            .setItems(labels) { _, which ->
+                val user = users[which]
+                scope.launch {
+                    val result = MultiUserHelper.installToUser(packageName, user.id)
+                    withContext(Dispatchers.Main) {
+                        toast(if (result.success) "Installed to ${user.name}" else "Failed: ${result.error}")
+                    }
+                }
+            }
+            .show()
+    }
+
+    private fun showDataDir() {
+        try {
+            RootExplorerHelper.openDataDir(context, packageName)
+        } catch (e: Exception) {
+            toast("Error: ${e.message}")
+        }
+    }
+
+    private fun showAppDir() {
+        try {
+            RootExplorerHelper.openAppDir(context, packageName)
+        } catch (e: Exception) {
+            toast("Error: ${e.message}")
+        }
+    }
+
+    var onSelectRequested: suspend () -> Unit = {}
+
+    private fun toast(msg: String) {
+        Toast.makeText(context, msg, Toast.LENGTH_SHORT).show()
+    }
+}

